# ─────────────────────────────────────────────────────────────────────────────
# BUILD-TIME vars — set as GitHub Actions secrets, NOT in Cloudflare.
#
# .github/workflows/deploy.yml builds the bundle on the GitHub runner and then
# uploads it with `wrangler pages deploy`. Cloudflare never runs the build, so
# a VITE_ var set in the Cloudflare Pages UI has no effect on the artifact.
#
# Anything VITE_-prefixed is inlined into the browser bundle and is PUBLIC.
# Only public identifiers belong here — never a token or secret.
# Also put these in .env.local for local Vite dev.
# ─────────────────────────────────────────────────────────────────────────────
VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME vars — Cloudflare Pages → the epsa-admin-dashboard project →
# Settings → Variables and secrets. Read by the Pages Functions in functions/.
# These are NEVER shipped to the browser.
#
# Mark FIREBASE_SERVICE_ACCOUNT and TURSO_AUTH_TOKEN as "Secret"
# (encrypted) rather than plaintext.
# ─────────────────────────────────────────────────────────────────────────────

# Microsoft — server-side MSAL token verification in functions/_auth.js.
# Same values as the VITE_ pair above; the audience check compares the token's
# `aud` against AZURE_CLIENT_ID.
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Turso — Screening Tool DB. Read-only token strongly recommended: the
# dashboard only reads from it (functions/_turso.js).
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Firebase — full service account JSON on a single line.
# Highest-value credential in the system: the Admin SDK bypasses every
# Firestore and Storage rule. Rotate in the Google Cloud console if exposed.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# REDCap — the dashboard does NOT hold the REDCap API token. It calls the
# epsa-redcap-proxy Worker, which holds REDCAP_TOKEN and REDCAP_API_URL as its
# own secrets.
#
# There is no shared secret: functions/records.js forwards the signed-in
# user's own Entra token, and the Worker verifies it. DASHBOARD_SECRET is
# obsolete — delete it from both this project and the Worker.
#
# REDCAP_PROXY_URL has no trailing path — functions/ append the route.
REDCAP_PROXY_URL=https://epsa-redcap-proxy.your-account.workers.dev
